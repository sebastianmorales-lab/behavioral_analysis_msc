#Calcular y comparar pendientes (emtrends) para cada nivel de resultadoParticipante y resultadoCojugador
print('##### EMTRENDS resultado jugador y PCA #####')
# Efecto marginal (interacción doble)
print("##### EMTRENDS efecto marginal #####")
pends1 <- emtrends(
modelo,
~ resultadoParticipante,
var = variable_psicologica
)
print(summary(pends1, infer = c(TRUE, TRUE)))
print(pairs(pends1, adjust = "holm"))
# Calcular y comparar pendientes (emtrends)
print("##### EMTRENDS interacción completa #####")
pends2 <- emtrends(
modelo,
~ resultadoParticipante * resultadoCojugador,
var = variable_psicologica
)
print(pends2)
print(pairs(pends2, adjust = "holm"))
return(modelo.ref.grid)
}
